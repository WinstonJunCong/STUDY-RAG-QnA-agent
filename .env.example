# Studio Knowledge API - Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Database Configuration
# ===================
# DB_TYPE: "sqlite" or "postgresql"
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=studio_kb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===================
# ChromaDB (Vector Store)
# ===================
# Directory for ChromaDB persistence
CHROMA_PERSIST_DIR=./data/chroma_db

# ===================
# Embedding Model
# ===================
# Local path to embedding model
EMBED_MODEL=D:\\huggingface_models\\Octen-8B

# ===================
# LLM (Ollama)
# ===================
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# ===================
# HuggingFace Cache
# ===================
HF_HOME=D:\\huggingface_cache
TRANSFORMERS_CACHE=D:\\huggingface_cache\\transformers
